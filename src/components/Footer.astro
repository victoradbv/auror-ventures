---
const path = Astro.url.pathname;
const isES = path.startsWith('/es');

// Base path
const base = isES ? '/es' : '/en';

// Translations (ONLY TEXT)
const t = isES
  ? {
      services: "Servicios",
      company: "Empresa",
      software: "Software & Cloud",
      dev: "Desarrollo de Software y Aplicaciones",
      cloud: "Infraestructura Cloud",
      bigData: "Soluciones de Big Data",
      data: "Analítica de Datos y Automatización",
      financial: "Software Financiero y de Inversión",
      about: "Sobre Nosotros",
      contact: "Contacto",
      legal: "Legal",
    }
  : {
      services: "Services",
      company: "Company",
      software: "Software & Cloud",
      dev: "Software & Application Development",
      cloud: "Cloud Infrastructure",
      bigData: "Big Data Solutions",
      data: "Data Analytics & Automation",
      financial: "Financial & Investment Software",
      about: "About Us",
      contact: "Contact",
      legal: "Legal",
    };

const serviceGroups = [
  {
    title: t.software,
    link: `${base}/software-cloud`,
    items: [
      { title: t.dev, link: `${base}/software-development` },
      { title: t.cloud, link: `${base}/cloud-infrastructure` },
    ],
  },
  {
    title: t.bigData,
    link: `${base}/finance-solutions`,
    items: [
      { title: t.data, link: `${base}/data-automations` },
      { title: t.financial, link: `${base}/asset-management` },
    ],
  },
];
---

<footer 
  class="mt-2 text-white"
  style="background-image: url('/images/Footer-background.jpg'); background-size: cover; background-position: center bottom;"
>

  <!-- Main Content -->
  <div class="container-custom h-auto lg:h-[130px] py-6 lg:py-1 flex items-center">

    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-6 items-start md:items-center w-full">

      <!-- Logo -->
      <div class="flex justify-start">
        <img 
          src="/images/White-logo.png" 
          alt="Auror Ventures" 
          class="h-14 md:h-20 lg:h-24 w-auto object-contain"
        />
      </div>

      <!-- Services + Company wrapper -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-10 md:contents">

        <!-- Services -->
        <div>
          <h3 class="mb-3 font-heading text-base text-white">
            {t.services}
          </h3>

          <div class="flex flex-col lg:flex-row gap-4 lg:gap-10">
            {serviceGroups.map(group => (
              <ul class="space-y-2 font-ui text-sm text-muted-light leading-tight">
                <li>
                  <a href={group.link} class="text-xs font-bold uppercase tracking-wider text-white hover:text-white/70 whitespace-nowrap">
                    {group.title}
                  </a>
                </li>
                {group.items.map(item => (
                  <li>
                    <a href={item.link} class="hover:text-white whitespace-nowrap">
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>

        <!-- Company -->
        <div class="md:justify-self-end">
          <h3 class="mb-3 font-heading text-base text-white">
            {t.company}
          </h3>

          <ul class="space-y-2 font-ui text-sm text-muted-light leading-tight">
            <li>
              <a href={`${base}/about-us`} class="hover:text-white">
                {t.about}
              </a>
            </li>
            <li>
              <a href={`${base}/contact`} class="hover:text-white">
                {t.contact}
              </a>
            </li>
            <li>
              <a href="#" class="hover:text-white">
                {t.legal}
              </a>
            </li>
          </ul>
        </div>

      </div>

    </div>

  </div>

  <!-- Bottom Bar -->
  <div class="bg-black text-muted-light text-xs">
    <div class="container-custom py-1 text-left">
      <span class="font-sans">©</span> aurorventures.com
    </div>
  </div>

</footer>