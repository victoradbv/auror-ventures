---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { tabTitle, description } = Astro.props;

const isES = Astro.url.pathname.startsWith('/es');
const lang = isES ? 'es' : 'en';

const pageTitle = tabTitle ? `${tabTitle} | Auror Ventures` : "Auror Ventures";
const pageDescription = description ?? (isES
  ? "Auror Ventures impulsa el crecimiento de negocios e inversores con soluciones de finanzas y tecnología."
  : "Auror Ventures empowers businesses and investors to grow through tailored finance and technology solutions.");
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const alternatePath = isES
  ? Astro.url.pathname.replace(/^\/es/, '/en')
  : Astro.url.pathname.replace(/^\/en/, '/es');
const alternateCanonical = new URL(alternatePath, Astro.site).href;

const keywords = isES
  ? "desarrollo de software, software a medida, consultoría tecnológica, desarrollo de aplicaciones web, startups, infraestructura cloud"
  : "software development, custom software, technology consulting, web app development, startups, cloud infrastructure";

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Auror Ventures",
  "url": "https://aurorventures.com",
  "description": isES
    ? "Auror Ventures impulsa el crecimiento de negocios e inversores con soluciones de finanzas y tecnología."
    : "Auror Ventures empowers businesses and investors to grow through tailored finance and technology solutions.",
  "areaServed": "Worldwide",
  "knowsAbout": ["Software Development", "Cloud Infrastructure", "Data Automation", "Web Development"],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "url": `https://aurorventures.com/${lang}/contact`
  }
});
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={isES ? alternateCanonical : canonical} />
    <link rel="alternate" hreflang="es" href={isES ? canonical : alternateCanonical} />
    <link rel="alternate" hreflang="x-default" href={isES ? alternateCanonical : canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Auror Ventures" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>

  <body class="relative flex flex-col min-h-screen">

    <!-- Header -->
    <Header />

    <!-- Page Content -->
    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <script is:inline defer src="/_vercel/insights/script.js"></script>

  </body>
</html>